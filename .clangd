CompileFlags:
  # Select a build locally via compile_commands.json or --compile-commands-dir.
  CompilationDatabase: Ancestors
  Remove:
    - -mfp16-format=*
    - -fno-printf-return-value
    - -fdiagnostics-color=*
    - -fmacro-prefix-map=*
    - --param=*
    - -mtp=*
    - -fno-reorder-functions
    - -fno-defer-pop
