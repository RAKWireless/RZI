+/* Optional product observer. Standalone USP keeps its original admission policy. */
+__attribute__((weak)) bool lorawan_fuota_context_supported(uint8_t stack, uint8_t port, uint8_t index)
+{ (void)stack; (void)port; (void)index; return true; }
+__attribute__((weak)) bool lorawan_fuota_storage_available(uint8_t stack)
+{ (void)stack; return true; }
+__attribute__((weak)) uint32_t lorawan_fuota_generation(uint8_t stack)
