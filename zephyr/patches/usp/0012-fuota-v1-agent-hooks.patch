+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+/* Optional v1 package integration. Defaults preserve standalone USP operation. */
+#ifndef LORAWAN_FUOTA_OBSERVER_H
+#define LORAWAN_FUOTA_OBSERVER_H
+#include <stdint.h>
+#include <stdbool.h>
+#include <stddef.h>
+enum lbm_fuota_notice {
+    LBM_FUOTA_FRAGMENT_SETUP, LBM_FUOTA_GROUP_SETUP, LBM_FUOTA_WINDOW_SETUP,
+    LBM_FUOTA_ENTERING, LBM_FUOTA_STARTED, LBM_FUOTA_ENDED, LBM_FUOTA_COMPLETE,
+    LBM_FUOTA_CONTROL_QUEUED, LBM_FUOTA_CONTROL_SENT,
+};
+struct lbm_fuota_info {
+    uint32_t generation;
+    uint16_t fragment_count;
+    uint8_t fragment_size, padding, index, multicast_mask, block_ack_delay;
+    uint32_t descriptor, session_time, timeout_s, frequency;
+    uint8_t data_rate, control;
+    bool successful;
+    int error;
+};
+/* Called under the modem lock, before accepted setup mutates package/FEC state.
+ * No supported context -> standard ID/index unsupported. Occupied data storage
+ * -> standard not-enough-memory. Never put a product error in RFU bits.
+ */
+bool lorawan_fuota_context_supported(uint8_t stack_id, uint8_t port, uint8_t index);
+bool lorawan_fuota_storage_available(uint8_t stack_id);
+bool lorawan_fuota_business_allowed(uint8_t stack_id);
+bool lorawan_fuota_class_b_supported(uint8_t stack_id);
+int lorawan_fuota_store(uint32_t offset, const uint8_t *buffer, size_t size);
+int lorawan_fuota_read(uint32_t offset, uint8_t *buffer, size_t size);
+int lorawan_fuota_storage_status(bool reset);
+size_t lorawan_fuota_storage_capacity(void);
+uint32_t lorawan_fuota_generation(uint8_t stack_id);
+void lorawan_fuota_observe(uint8_t stack_id, enum lbm_fuota_notice notice,
+                          const struct lbm_fuota_info *info);
+/* Synchronous cancellation: stops monitoring and clears pending launch/stop bits.
+ * Leaves group security and fragmentation control state intact for cleanup.
+ */
+void lorawan_remote_multicast_setup_cancel_class_c(uint8_t stack_id, uint8_t group);
+/* Explicit storage lifecycle boundary; never erases or overwrites retained bytes. */
+void lorawan_fragmentation_release(uint8_t stack_id);
+#endif
