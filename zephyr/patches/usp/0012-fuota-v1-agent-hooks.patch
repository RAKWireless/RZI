+
+void lorawan_remote_multicast_setup_cancel_class_c(uint8_t stack, uint8_t group)
+{
+    if (group >= NB_MULTICAST_GROUPS) { return; }
+    for (unsigned int i = 0; i < NUMBER_OF_REMOTE_MULTICAST_SETUP_PACKAGE_OBJ; ++i) {
+        lorawan_remote_multicast_setup_package_ctx_t *ctx = &lorawan_remote_multicast_setup_package_ctx[i];
+        if (ctx->stack_id != stack) { continue; }
+        lorawan_api_multicast_c_stop_session(group, stack);
+        ctx->launch_class_c[group] = false;
+        ctx->stop_class_c[group] = false;
+        ctx->task_ctx_mask &= ~((1UL << (LAUNCH_CLASS_C_TASK_GROUP_ID_0 + group)) |
+                                (1UL << (STOP_CLASS_C_TASK_GROUP_ID_0 + group)));
+    }
+}
