+                                               const struct lbm_fuota_info *info)
+{ (void)stack; (void)notice; (void)info; }
+void lorawan_fragmentation_release(uint8_t stack)
+{
+    if (stack >= NUMBER_OF_FRAGMENTED_PACKAGE_OBJ) { return; }
+    for (unsigned int i = 0; i < FRAGMENTATION_MAX_NB_SESSIONS; ++i) {
+        frag_session_data[i].frag_group_data.is_active = false;
+    }
+}
+
+__attribute__((weak)) bool lorawan_fuota_business_allowed(uint8_t stack)
+{ (void)stack; return true; }
+
+__attribute__((weak)) int lorawan_fuota_store(uint32_t offset, const uint8_t *data, size_t size)
+{ smtc_modem_hal_context_store(CONTEXT_FUOTA, offset, data, (uint32_t)size); return 0; }
+__attribute__((weak)) int lorawan_fuota_read(uint32_t offset, uint8_t *data, size_t size)
+{ smtc_modem_hal_context_restore(CONTEXT_FUOTA, offset, data, (uint32_t)size); return 0; }
+__attribute__((weak)) int lorawan_fuota_storage_status(bool reset)
+{ (void)reset; return 0; }
+
+__attribute__((weak)) size_t lorawan_fuota_storage_capacity(void)
+{ return FragDecoderGetMaxFileSize(); }
+
+__attribute__((weak)) bool lorawan_fuota_class_b_supported(uint8_t stack)
+{ (void)stack; return true; }
