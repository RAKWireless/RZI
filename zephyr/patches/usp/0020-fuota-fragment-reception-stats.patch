+/* Managed reception admits one generation. TS004 N is a 14-bit wire number,
+ * independent of NbFrag: redundancy packets can use the full number space. */
+static uint8_t fragment_seen[(1U << 14) / 8];
+static uint32_t stats_generation;
+static struct lbm_fuota_rx_stats rx_stats;
+
+bool lorawan_fragmentation_get_rx_stats(uint32_t generation, struct lbm_fuota_rx_stats *out)
+{
+    if (generation == 0 || generation != stats_generation) {
+        return false;
+    }
+    *out = rx_stats;
+    return true;
+}
+
+static void record_fragment(const frag_group_data_t *group, uint16_t number, const uint8_t *payload)
+{
+    uint8_t mask = 1U << (number & 7);
+    uint8_t *seen = &fragment_seen[number >> 3];
+    if ((*seen & mask) != 0) {
+        return;
+    }
+    *seen |= mask;
+    ++rx_stats.received;
+    /* Keep the received block prefix for the application even on a failed write.
+     * Only systematic payload bytes have a file offset; padding is excluded. */
+    if (number <= group->frag_nb) {
+        uint32_t start = (uint32_t)(number - 1) * group->frag_size;
+        uint32_t end = start + group->frag_size - (number == group->frag_nb ? group->padding : 0);
+        for (uint32_t pos = start; pos < end && pos < sizeof(rx_stats.prefix); ++pos) {
+            rx_stats.prefix[pos] = payload[pos - start];
+            rx_stats.prefix_valid |= 1U << pos;
+        }
+    }
+}
+#endif
