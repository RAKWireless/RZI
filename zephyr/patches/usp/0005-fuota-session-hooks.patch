                                                             uint8_t app_skey[SMTC_MODEM_KEY_LENGTH] );
 
+/**
+ * @brief Application hooks for a v1 fragmentation session
+ *
+ * @remark session_setup runs before the decoder starts. Return 0 to accept the
+ *         session. 0x02 means not enough memory and 0x08 means the descriptor
+ *         was rejected; both bits are copied into FragSessionSetupAns.
+ *         store and restore replace CONTEXT_FUOTA for the reconstructed bytes.
+ *         All three run on the modem thread and must not call the modem API.
+ */
+struct smtc_modem_fuota_hooks
+{
+    uint8_t ( *session_setup )( uint32_t descriptor, uint16_t frag_nb, uint8_t frag_size, uint8_t padding );
+    int ( *store )( uint32_t offset, const uint8_t* data, uint32_t size );
+    int ( *restore )( uint32_t offset, uint8_t* data, uint32_t size );
+    /** Called after FragSessionDelete clears the session and before the next command. */
+    void ( *session_delete )( uint32_t generation );
+};
+
+/** Identity of one accepted FragSessionSetup. The descriptor is little-endian. */
+struct smtc_modem_fuota_setup
+{
+    uint32_t generation;
+    uint32_t descriptor;
+    uint16_t frag_nb;
+    uint8_t  frag_size;
+    uint8_t  padding;
+    uint8_t  frag_index;
+    uint8_t  mc_group_bit_mask;
+    uint8_t  frag_algo;
+    uint8_t  block_ack_delay;
+};
+
+/**
+ * @brief Register fragmentation session hooks
+ *
+ * @param [in] hooks Hook table, or NULL to restore CONTEXT_FUOTA storage.
+ *                   The pointer is kept, so the table must stay valid.
+ */
+void smtc_modem_fuota_set_hooks( const struct smtc_modem_fuota_hooks* hooks );
+
+/** Generation assigned by the active session_setup hook. Read before FragDecoderInit. */
+uint32_t smtc_modem_fuota_generation( void );
+/** Publish one accepted setup. Modem thread; do not call another modem API. */
+void smtc_modem_fuota_notify_setup( const struct smtc_modem_fuota_setup* setup );
+/** Class in force when a Class C window is accepted. lorawan_class is smtc_modem_class_t. */
+void smtc_modem_fuota_notify_class( uint8_t lorawan_class, uint8_t group_id );
+/** A fragmentation answer finished local transmission. control bit0 Status, bit1 Delete. */
+void smtc_modem_fuota_notify_control( uint32_t generation, uint8_t control );
+/** False while the product service is receiving or applying. Lock-free. */
+bool smtc_modem_fuota_business_allowed( void );
+/** True while a fragmentation answer is queued or transmitting. Lock-free. */
+bool lorawan_fragmentation_answer_pending( uint8_t stack_id );
+/** True while a remote-multicast answer is queued or transmitting. Lock-free. */
+bool lorawan_multicast_answer_pending( uint8_t stack_id );
+
 #ifdef __cplusplus
 }
 #endif
