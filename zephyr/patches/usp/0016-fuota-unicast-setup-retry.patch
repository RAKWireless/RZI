+/* Compare negotiated fields only. Decoder counters and storage contents are live. */
+static bool same_setup(const frag_group_data_t *active, const frag_group_data_t *request,
+                       uint32_t generation)
+{
+    return active->is_active && active->generation == generation &&
+           active->frag_session.frag_index == request->frag_session.frag_index &&
+           active->frag_session.mc_group_bit_mask == request->frag_session.mc_group_bit_mask &&
+           active->frag_nb == request->frag_nb && active->frag_size == request->frag_size &&
+           active->control.frag_algo == request->control.frag_algo &&
+           active->control.block_ack_delay == request->control.block_ack_delay &&
+           active->padding == request->padding && active->descriptor == request->descriptor;
+}
+
+bool lorawan_fragmentation_answer_pending(uint8_t stack_id)
+{
+    return stack_id < NUMBER_OF_FRAGMENTED_PACKAGE_OBJ &&
+           lorawan_fragmentation_package_ctx[stack_id].is_pending_task;
+}
