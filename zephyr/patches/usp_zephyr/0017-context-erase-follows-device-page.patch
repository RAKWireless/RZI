diff --git a/modules/smtc_modem_hal/smtc_modem_hal_storage.c b/modules/smtc_modem_hal/smtc_modem_hal_storage.c
index 2caf382..01f35a6 100644
--- a/modules/smtc_modem_hal/smtc_modem_hal_storage.c
+++ b/modules/smtc_modem_hal/smtc_modem_hal_storage.c
@@ -134,12 +134,10 @@ void smtc_modem_hal_context_restore( const modem_context_type_t ctx_type, uint32
     flash_area_read( context_flash_area, real_offset, buffer, size );
 }
 
-/* NOTE: We take here the maximum erase size out there to do read-erase-write */
-// #define PAGE_BUFFER_SIZE 4096
-#define PAGE_BUFFER_SIZE                                     \
-    DT_PROP_OR( DT_CHOSEN( zephyr_flash ), erase_block_size, \
-                4096 )  // Should match sector (page) size for each different architectures as 'zephyr, flash' is almost
-                        // always used
+/* Buffer must cover the context device erase page. STM32WL internal pages are
+ * 2 KiB, but the MX25L400 sector is 4 KiB. Erase length follows the device page.
+ */
+#define PAGE_BUFFER_SIZE MAX( DT_PROP_OR( DT_CHOSEN( zephyr_flash ), erase_block_size, 4096 ), 4096 )
 
 // For the min erase size in bytes, we use write_block_size property
 // Defaults to 8 if not present
@@ -162,26 +160,37 @@ static void flash_read_modify_write( uint32_t offset, const uint8_t* buffer, con
     {
         uint32_t offset_in_data = size - remaining;
 
-        memset( page_buffer, 0xFF, PAGE_BUFFER_SIZE );
-
         /* Find out the page information in the flash */
-        flash_get_page_info_by_offs( flash_device, context_flash_area->fa_off + offset + offset_in_data, &info );
+        if( flash_get_page_info_by_offs( flash_device, context_flash_area->fa_off + offset + offset_in_data,
+                                         &info ) != 0 )
+        {
+            LOG_ERR( "Context page lookup failed at offset %u", offset + offset_in_data );
+            return;
+        }
+        if( info.size == 0U || info.size > PAGE_BUFFER_SIZE )
+        {
+            LOG_ERR( "Context erase page %u does not fit the %u byte buffer", ( unsigned int ) info.size,
+                     ( unsigned int ) PAGE_BUFFER_SIZE );
+            return;
+        }
         uint32_t page_offset_in_fa = info.start_offset - context_flash_area->fa_off;
 
+        memset( page_buffer, 0xFF, info.size );
+
         /* Read the whole page */
-        flash_area_read( context_flash_area, page_offset_in_fa, page_buffer, PAGE_BUFFER_SIZE );
+        flash_area_read( context_flash_area, page_offset_in_fa, page_buffer, info.size );
 
         /* Fill the data in the buffer */
         uint32_t offset_in_page = offset + offset_in_data - page_offset_in_fa;
-        uint32_t length         = MIN( remaining, PAGE_BUFFER_SIZE - offset_in_page );
+        uint32_t length         = MIN( remaining, info.size - offset_in_page );
 
         memcpy( page_buffer + offset_in_page, buffer + offset_in_data, length );
 
         /* Erase before write */
-        flash_area_erase( context_flash_area, page_offset_in_fa, PAGE_BUFFER_SIZE );
+        flash_area_erase( context_flash_area, page_offset_in_fa, info.size );
 
         /* Write the whole page */
-        flash_area_write( context_flash_area, page_offset_in_fa, page_buffer, PAGE_BUFFER_SIZE );
+        flash_area_write( context_flash_area, page_offset_in_fa, page_buffer, info.size );
         remaining -= length;
 
     } while( remaining > 0 );
