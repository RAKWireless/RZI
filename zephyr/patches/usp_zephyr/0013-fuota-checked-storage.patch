+}
+
+#ifdef CONFIG_RZI_LORAWAN_FUOTA_AGENT
+/* Provider-owned checked access. No new allocation, partition, or address map. */
+static int fuota_storage_error;
+static int fuota_range(uint32_t offset, size_t size)
+{
+    flash_init();
+    if (!context_flash_area) { return -ENODEV; }
+    if (context_flash_area->fa_size < ADDR_FUOTA_CONTEXT_OFFSET) { return -ENOSPC; }
+    size_t capacity = context_flash_area->fa_size - ADDR_FUOTA_CONTEXT_OFFSET;
+#ifdef ADD_SMTC_STORE_AND_FORWARD
+    capacity = MIN(capacity, ADDR_STORE_AND_FORWARD_CONTEXT_OFFSET - ADDR_FUOTA_CONTEXT_OFFSET);
+#endif
+    return offset <= capacity && size <= capacity - offset ? 0 : -EINVAL;
+}
+size_t lorawan_fuota_storage_capacity(void)
+{
+    flash_init();
+    if (!context_flash_area || context_flash_area->fa_size < ADDR_FUOTA_CONTEXT_OFFSET) { return 0; }
+    size_t capacity = context_flash_area->fa_size - ADDR_FUOTA_CONTEXT_OFFSET;
+#ifdef ADD_SMTC_STORE_AND_FORWARD
+    capacity = MIN(capacity, ADDR_STORE_AND_FORWARD_CONTEXT_OFFSET - ADDR_FUOTA_CONTEXT_OFFSET);
+#endif
+    return capacity;
+}
+int lorawan_fuota_storage_status(bool reset)
+{
+    int rc = fuota_storage_error;
+    if (reset) { fuota_storage_error = 0; }
+    return rc;
+}
+int lorawan_fuota_store(uint32_t offset, const uint8_t *buffer, size_t size)
+{
+    int rc = buffer && size ? fuota_range(offset, size) : -EINVAL;
+    if (!rc) { rc = flash_read_modify_write(ADDR_FUOTA_CONTEXT_OFFSET + offset, buffer, size); }
+    if (rc && !fuota_storage_error) { fuota_storage_error = rc; }
+    return rc;
+}
+int lorawan_fuota_read(uint32_t offset, uint8_t *buffer, size_t size)
+{
+    int rc = buffer && size ? fuota_range(offset, size) : -EINVAL;
+    if (!rc) { rc = flash_area_read(context_flash_area, ADDR_FUOTA_CONTEXT_OFFSET + offset, buffer, size); }
+    if (rc && !fuota_storage_error) { fuota_storage_error = rc; }
+    return rc;
+}
+#endif
 
 void smtc_modem_hal_context_store( const modem_context_type_t ctx_type, uint32_t offset, const uint8_t* buffer,
                                    const uint32_t size )
