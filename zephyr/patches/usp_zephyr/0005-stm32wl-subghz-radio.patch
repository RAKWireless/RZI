+ * CONTRIBUTORS "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT
+ * NOT LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A
+ * PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL SEMTECH CORPORATION BE
+ * LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
+ * POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include <zephyr/kernel.h>
+#include <zephyr/device.h>
+#include <zephyr/drivers/gpio.h>
+#include <zephyr/irq.h>
+#include <zephyr/logging/log.h>
+#include <zephyr/sys/util.h>
+
+#include <stm32_ll_bus.h>
+#include <stm32_ll_exti.h>
+#include <stm32_ll_pwr.h>
+#include <stm32_ll_rcc.h>
+#include <stm32_ll_spi.h>
+
+#include <sx126x.h>
+#include <sx126x_hal.h>
+#include "sx126x_hal_context.h"
+
+LOG_MODULE_DECLARE( lora_sx126x, CONFIG_LORA_BASICS_MODEM_DRIVERS_LOG_LEVEL );
+
+#define SX126X_CMD_CLR_IRQ_STATUS           0x02U
+#define SX126X_CMD_SET_STANDBY              0x80U
+#define SX126X_CMD_SET_RX                   0x82U
+#define SX126X_CMD_SET_TX                   0x83U
+#define SX126X_CMD_SET_SLEEP                0x84U
+#define SX126X_CMD_SET_RX_DUTY_CYCLE        0x94U
+#define SX126X_CMD_SET_FS                   0xC1U
+#define SX126X_CMD_SET_CAD                  0xC5U
+#define SX126X_CMD_SET_TX_CONTINUOUS_WAVE   0xD1U
+#define SX126X_CMD_SET_TX_INFINITE_PREAMBLE 0xD2U
+
+/* Match STM32CubeWL HAL SUBGHZ_DEFAULT_TIMEOUT (100 ms), SUBGHZ_DUMMY_DATA,
+ * and SUBGHZ_DEFAULT_LOOP_TIME in stm32wlxx_hal_subghz.c.
+ */
+#define SUBGHZ_DEFAULT_TIMEOUT_MS 100U
+#define SUBGHZ_DUMMY_DATA         0xFFU
+#define SUBGHZ_DEFAULT_LOOP_TIME  ( ( SystemCoreClock * 28U ) >> 19U )
+
+static uint32_t subghzspi_calc_prescaler( uint32_t max_hz )
+{
+    static const uint32_t prescalers[] = {
+        LL_SPI_BAUDRATEPRESCALER_DIV2,   LL_SPI_BAUDRATEPRESCALER_DIV4,   LL_SPI_BAUDRATEPRESCALER_DIV8,
+        LL_SPI_BAUDRATEPRESCALER_DIV16,  LL_SPI_BAUDRATEPRESCALER_DIV32,  LL_SPI_BAUDRATEPRESCALER_DIV64,
+        LL_SPI_BAUDRATEPRESCALER_DIV128, LL_SPI_BAUDRATEPRESCALER_DIV256,
+    };
+    uint32_t hclk3 = __LL_RCC_CALC_HCLK3_FREQ( SystemCoreClock, LL_RCC_GetAHB3Prescaler( ) );
+
+    if( max_hz == 0U )
+    {
+        return LL_SPI_BAUDRATEPRESCALER_DIV8;
+    }
+
+    for( size_t i = 0U; i < ARRAY_SIZE( prescalers ); i++ )
+    {
+        if( ( hclk3 >> ( i + 1U ) ) <= max_hz )
+        {
+            return prescalers[i];
+        }
+    }
+
+    return LL_SPI_BAUDRATEPRESCALER_DIV256;
+}
+
+static void subghzspi_init( uint32_t max_hz )
+{
+    uint32_t br       = subghzspi_calc_prescaler( max_hz );
+    uint32_t cr1_want = SPI_CR1_MSTR | SPI_CR1_SSI | SPI_CR1_SSM | br;
+    uint32_t cr2_want = SPI_CR2_FRXTH | SPI_CR2_DS_0 | SPI_CR2_DS_1 | SPI_CR2_DS_2;
+
+    LL_APB3_GRP1_EnableClock( LL_APB3_GRP1_PERIPH_SUBGHZSPI );
+
+    /* STOP mode clears SUBGHZSPI CR1/CR2; reprogram whenever SPE or mode was lost. */
+    if( ( SUBGHZSPI->CR1 != ( cr1_want | SPI_CR1_SPE ) ) || ( SUBGHZSPI->CR2 != cr2_want ) )
+    {
+        CLEAR_BIT( SUBGHZSPI->CR1, SPI_CR1_SPE );
+        WRITE_REG( SUBGHZSPI->CR1, cr1_want );
+        WRITE_REG( SUBGHZSPI->CR2, cr2_want );
+        SET_BIT( SUBGHZSPI->CR1, SPI_CR1_SPE );
+    }
+
+    while( LL_SPI_IsActiveFlag_RXNE( SUBGHZSPI ) )
+    {
+        ( void ) LL_SPI_ReceiveData8( SUBGHZSPI );
+    }
+    LL_SPI_ClearFlag_OVR( SUBGHZSPI );
+}
+
+static bool subghzspi_transmit( uint8_t data )
+{
+    volatile uint32_t count = SUBGHZ_DEFAULT_TIMEOUT_MS * SUBGHZ_DEFAULT_LOOP_TIME;
+
+    do
+    {
+        if( count == 0U )
+        {
+            return false;
+        }
+        count--;
+    } while( !LL_SPI_IsActiveFlag_TXE( SUBGHZSPI ) );
+
+    LL_SPI_TransmitData8( SUBGHZSPI, data );
+
+    count = SUBGHZ_DEFAULT_TIMEOUT_MS * SUBGHZ_DEFAULT_LOOP_TIME;
+    do
+    {
+        if( count == 0U )
+        {
+            return false;
+        }
+        count--;
+    } while( !LL_SPI_IsActiveFlag_RXNE( SUBGHZSPI ) );
+
+    ( void ) LL_SPI_ReceiveData8( SUBGHZSPI );
+    return true;
+}
+
+static bool subghzspi_receive( uint8_t* data )
+{
+    volatile uint32_t count = SUBGHZ_DEFAULT_TIMEOUT_MS * SUBGHZ_DEFAULT_LOOP_TIME;
+
+    do
+    {
+        if( count == 0U )
+        {
+            return false;
+        }
+        count--;
+    } while( !LL_SPI_IsActiveFlag_TXE( SUBGHZSPI ) );
+
+    LL_SPI_TransmitData8( SUBGHZSPI, SUBGHZ_DUMMY_DATA );
+
+    count = SUBGHZ_DEFAULT_TIMEOUT_MS * SUBGHZ_DEFAULT_LOOP_TIME;
+    do
+    {
+        if( count == 0U )
+        {
+            return false;
+        }
+        count--;
+    } while( !LL_SPI_IsActiveFlag_RXNE( SUBGHZSPI ) );
+
+    *data = LL_SPI_ReceiveData8( SUBGHZSPI );
+    return true;
+}
+
+static void subghz_wait_on_busy( void )
+{
+    uint32_t end = k_uptime_get_32( ) + CONFIG_LORA_BASICS_MODEM_DRIVERS_HAL_WAIT_ON_BUSY_TIMEOUT_MSEC;
+
+    while( LL_PWR_IsActiveFlag_RFBUSYS( ) != 0U )
+    {
+        if( k_uptime_get_32( ) > end )
+        {
+            LOG_ERR( "Timeout of %dms hit when waiting for STM32WL RFBUSY!",
+                     CONFIG_LORA_BASICS_MODEM_DRIVERS_HAL_WAIT_ON_BUSY_TIMEOUT_MSEC );
+            k_oops( );
+        }
+        k_usleep( 100 );
+    }
+}
+
+static void subghz_check_device_ready( struct sx126x_hal_context_data_t* data )
+{
+    /* Match ST SUBGHZ_CheckDeviceReady(): wake deep sleep by pulsing NSS and
+     * waiting for RFBUSY low before releasing NSS, with no SPI byte clocked.
+     */
+    if( data->radio_status == RADIO_SLEEP )
+    {
+        LL_PWR_SelectSUBGHZSPI_NSS( );
+        subghz_wait_on_busy( );
+        LL_PWR_UnselectSUBGHZSPI_NSS( );
+        data->radio_status = RADIO_AWAKE;
+    }
+    else
+    {
+        subghz_wait_on_busy( );
+    }
+}
+
+static void subghz_set_rf_path( const struct sx126x_hal_context_cfg_t* config, uint8_t opcode )
+{
+    bool tx;
+    bool rx;
+    bool idle;
+
+    if( !config->tx_enable.port && !config->rx_enable.port && !config->antenna_enable.port )
+    {
+        return;
+    }
+
+    tx   = ( opcode == SX126X_CMD_SET_TX ) || ( opcode == SX126X_CMD_SET_TX_CONTINUOUS_WAVE ) ||
+         ( opcode == SX126X_CMD_SET_TX_INFINITE_PREAMBLE );
+    rx   = ( opcode == SX126X_CMD_SET_RX ) || ( opcode == SX126X_CMD_SET_RX_DUTY_CYCLE ) ||
+         ( opcode == SX126X_CMD_SET_CAD );
+    idle = ( opcode == SX126X_CMD_SET_STANDBY ) || ( opcode == SX126X_CMD_SET_SLEEP ) ||
+           ( opcode == SX126X_CMD_SET_FS );
+
+    if( tx )
+    {
+        if( config->rx_enable.port )
+        {
+            gpio_pin_set_dt( &config->rx_enable, 0 );
+        }
+        if( config->tx_enable.port )
+        {
+            gpio_pin_set_dt( &config->tx_enable, 1 );
+        }
+        if( config->antenna_enable.port )
+        {
+            gpio_pin_set_dt( &config->antenna_enable, 1 );
+        }
+    }
+    else if( rx )
+    {
+        if( config->tx_enable.port )
+        {
+            gpio_pin_set_dt( &config->tx_enable, 0 );
+        }
+        if( config->rx_enable.port )
+        {
+            gpio_pin_set_dt( &config->rx_enable, 1 );
+        }
+        if( config->antenna_enable.port )
+        {
+            gpio_pin_set_dt( &config->antenna_enable, 1 );
+        }
+    }
+    else if( idle )
+    {
+        if( config->tx_enable.port )
+        {
+            gpio_pin_set_dt( &config->tx_enable, 0 );
+        }
+        if( config->rx_enable.port )
+        {
+            gpio_pin_set_dt( &config->rx_enable, 0 );
+        }
+        if( config->antenna_enable.port )
+        {
+            gpio_pin_set_dt( &config->antenna_enable, 0 );
+        }
+    }
+}
+
+/* Radio reset clears the VDDTCXO regulator. Park the CPU on HSI first when
+ * SYSCLK comes from that TCXO, then program the regulator before using HSE.
+ */
+static bool stm32wl_cpu_clock_is_tcxo( void )
+{
+    uint32_t source = LL_RCC_GetSysClkSource( );
+
+    if( LL_RCC_HSE_IsEnabledTcxo( ) == 0U )
+    {
+        return false;
+    }
+    return source == LL_RCC_SYS_CLKSOURCE_STATUS_HSE || source == LL_RCC_SYS_CLKSOURCE_STATUS_PLL;
+}
+
+static bool stm32wl_wait_until( uint32_t ( *flag )( void ), uint32_t expected )
+{
+    for( uint32_t i = 0U; i < 1000000U; i++ )
+    {
+        if( flag( ) == expected )
+        {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void stm32wl_park_on_hsi( void )
+{
+    LL_RCC_HSI_Enable( );
+    ( void ) stm32wl_wait_until( LL_RCC_HSI_IsReady, 1U );
+    LL_RCC_SetSysClkSource( LL_RCC_SYS_CLKSOURCE_HSI );
+    ( void ) stm32wl_wait_until( LL_RCC_GetSysClkSource, LL_RCC_SYS_CLKSOURCE_STATUS_HSI );
+    LL_RCC_PLL_Disable( );
+    ( void ) stm32wl_wait_until( LL_RCC_PLL_IsReady, 0U );
+}
+
+static void stm32wl_restore_hse_pll( void )
+{
+    LL_RCC_HSE_Disable( );
+    ( void ) stm32wl_wait_until( LL_RCC_HSE_IsReady, 0U );
+    LL_RCC_HSE_EnableTcxo( );
+    LL_RCC_HSE_Enable( );
+    if( !stm32wl_wait_until( LL_RCC_HSE_IsReady, 1U ) )
+    {
+        LOG_ERR( "HSE TCXO did not restart after radio reset" );
+        return;
+    }
+    LL_RCC_PLL_Enable( );
+    if( !stm32wl_wait_until( LL_RCC_PLL_IsReady, 1U ) )
+    {
+        LOG_ERR( "PLL did not lock after radio reset" );
+        return;
+    }
+    LL_RCC_SetSysClkSource( LL_RCC_SYS_CLKSOURCE_PLL );
+    ( void ) stm32wl_wait_until( LL_RCC_GetSysClkSource, LL_RCC_SYS_CLKSOURCE_STATUS_PLL );
+}
+
+/*
+ * -----------------------------------------------------------------------------
+ * --- PUBLIC FUNCTIONS DEFINITION ---------------------------------------------
+ */
+
+sx126x_hal_status_t sx126x_hal_write( const void* context, const uint8_t* command, const uint16_t command_length,
+                                      const uint8_t* data, const uint16_t data_length )
+{
+    const struct device*                   dev      = ( const struct device* ) context;
+    const struct sx126x_hal_context_cfg_t* config   = dev->config;
+    struct sx126x_hal_context_data_t*      dev_data = dev->data;
+    uint8_t                                opcode;
+
+    if( command_length == 0U )
+    {
+        return SX126X_HAL_STATUS_ERROR;
+    }
+
+    opcode = command[0];
+
+    subghzspi_init( config->spi_max_hz );
+    subghz_check_device_ready( dev_data );
+
+    LL_PWR_SelectSUBGHZSPI_NSS( );
+
+    for( uint16_t i = 0U; i < command_length; i++ )
+    {
+        if( !subghzspi_transmit( command[i] ) )
+        {
+            LL_PWR_UnselectSUBGHZSPI_NSS( );
+            return SX126X_HAL_STATUS_ERROR;
+        }
+    }
+
+    for( uint16_t i = 0U; i < data_length; i++ )
+    {
+        if( !subghzspi_transmit( data[i] ) )
+        {
+            LL_PWR_UnselectSUBGHZSPI_NSS( );
+            return SX126X_HAL_STATUS_ERROR;
+        }
+    }
+
+    LL_PWR_UnselectSUBGHZSPI_NSS( );
+
+    /* Match HAL_SUBGHZ_ExecSetCmd(): both SetSleep and SetRxDutyCycle enter
+     * deep sleep (wake with NSS), and SetSleep must not poll RFBUSY after NSS.
+     */
+    if( ( opcode == SX126X_CMD_SET_SLEEP ) || ( opcode == SX126X_CMD_SET_RX_DUTY_CYCLE ) )
+    {
+        dev_data->radio_status = RADIO_SLEEP;
+    }
+
+    if( opcode != SX126X_CMD_SET_SLEEP )
+    {
+        subghz_wait_on_busy( );
+    }
+
+    /* The radio IRQ line stays high until ClearIrqStatus. Re-arm NVIC after
+     * the line drops.
+     */
+    if( opcode == SX126X_CMD_CLR_IRQ_STATUS )
+    {
+        LL_EXTI_ClearFlag_32_63( LL_EXTI_LINE_44 );
+        NVIC_ClearPendingIRQ( config->irqn );
+        irq_enable( config->irqn );
+    }
+
+    subghz_set_rf_path( config, opcode );
+
+    return SX126X_HAL_STATUS_OK;
+}
+
+sx126x_hal_status_t sx126x_hal_read( const void* context, const uint8_t* command, const uint16_t command_length,
+                                     uint8_t* data, const uint16_t data_length )
+{
+    const struct device*                   dev      = ( const struct device* ) context;
+    const struct sx126x_hal_context_cfg_t* config   = dev->config;
+    struct sx126x_hal_context_data_t*      dev_data = dev->data;
+
+    subghzspi_init( config->spi_max_hz );
+    subghz_check_device_ready( dev_data );
+
+    LL_PWR_SelectSUBGHZSPI_NSS( );
+
+    for( uint16_t i = 0U; i < command_length; i++ )
+    {
+        if( !subghzspi_transmit( command[i] ) )
+        {
+            LL_PWR_UnselectSUBGHZSPI_NSS( );
+            return SX126X_HAL_STATUS_ERROR;
+        }
+    }
+
+    for( uint16_t i = 0U; i < data_length; i++ )
+    {
+        if( !subghzspi_receive( &data[i] ) )
+        {
+            LL_PWR_UnselectSUBGHZSPI_NSS( );
+            return SX126X_HAL_STATUS_ERROR;
+        }
+    }
+
+    LL_PWR_UnselectSUBGHZSPI_NSS( );
+
+    subghz_wait_on_busy( );
+
+    return SX126X_HAL_STATUS_OK;
+}
+
+sx126x_hal_status_t sx126x_hal_reset( const void* context )
+{
+    const struct device*                   dev    = ( const struct device* ) context;
+    const struct sx126x_hal_context_cfg_t* config = dev->config;
+    struct sx126x_hal_context_data_t*      data   = dev->data;
+    bool                                   tcxo   = config->tcxo_cfg.xosc_cfg == RAL_XOSC_CFG_TCXO_RADIO_CTRL;
+    bool                                   parked = tcxo && stm32wl_cpu_clock_is_tcxo( );
+
+    if( parked )
+    {
+        stm32wl_park_on_hsi( );
+    }
+
+    LL_RCC_RF_EnableReset( );
+    k_busy_wait( 20000 );
+    LL_RCC_RF_DisableReset( );
+    ( void ) stm32wl_wait_until( LL_RCC_IsRFUnderReset, 0U );
+    LL_PWR_UnselectSUBGHZSPI_NSS( );
+    LL_PWR_SetRadioBusyTrigger( LL_PWR_RADIO_BUSY_TRIGGER_WU_IT );
+    LL_PWR_ClearFlag_RFBUSY( );
+
+    subghzspi_init( config->spi_max_hz );
+
+    data->radio_status = RADIO_SLEEP;
+    subghz_check_device_ready( data );
+
+    if( tcxo )
+    {
+        uint32_t timeout = sx126x_convert_timeout_in_ms_to_rtc_step( config->tcxo_cfg.wakeup_time_ms );
+
+        ( void ) sx126x_set_dio3_as_tcxo_ctrl( context, config->tcxo_cfg.voltage, timeout );
+        if( config->tcxo_cfg.wakeup_time_ms != 0U )
+        {
+            k_busy_wait( config->tcxo_cfg.wakeup_time_ms * 1000U );
+        }
+    }
+
+    if( parked )
+    {
+        stm32wl_restore_hse_pll( );
+    }
+
+    return SX126X_HAL_STATUS_OK;
+}
+
+sx126x_hal_status_t sx126x_hal_wakeup( const void* context )
+{
+    const struct device*              dev  = ( const struct device* ) context;
+    struct sx126x_hal_context_data_t* data = dev->data;
+
+    subghz_check_device_ready( data );
+    return SX126X_HAL_STATUS_OK;
+}
