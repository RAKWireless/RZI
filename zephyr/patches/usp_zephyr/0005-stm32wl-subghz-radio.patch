+#include <zephyr/kernel.h>
+#include <zephyr/device.h>
+#include <zephyr/devicetree.h>
+#include <zephyr/drivers/gpio.h>
+#include <zephyr/irq.h>
+#include <zephyr/logging/log.h>
+#include <zephyr/pm/device.h>
+#include <zephyr/sys/util.h>
+
+#include <stm32_ll_bus.h>
+#include <stm32_ll_exti.h>
+#include <stm32_ll_pwr.h>
+#include <stm32_ll_rcc.h>
+
+#include <ral_sx126x_bsp.h>
+#include <sx126x.h>
+#include <zephyr/usp/lora_lbm_transceiver.h>
+#include "sx126x_hal_context.h"
+
+LOG_MODULE_REGISTER( lora_sx126x, CONFIG_LORA_BASICS_MODEM_DRIVERS_LOG_LEVEL );
+
+#ifdef CONFIG_LORA_BASICS_MODEM_DRIVERS_EVENT_TRIGGER_OWN_THREAD
+static void subghz_event_thread( struct sx126x_hal_context_data_t* data )
+{
+    while( 1 )
+    {
+        k_sem_take( &data->trig_sem, K_FOREVER );
+        if( data->event_interrupt_cb )
+        {
+            data->event_interrupt_cb( data->sx126x_dev );
+        }
+    }
+}
+#endif
+
+#ifdef CONFIG_LORA_BASICS_MODEM_DRIVERS_EVENT_TRIGGER_GLOBAL_THREAD
+static void subghz_work_cb( struct k_work* work )
+{
+    struct sx126x_hal_context_data_t* data = CONTAINER_OF( work, struct sx126x_hal_context_data_t, work );
+
+    if( data->event_interrupt_cb )
+    {
+        data->event_interrupt_cb( data->sx126x_dev );
+    }
+}
+#endif
+
+static void subghz_isr( const struct device* dev )
+{
+    const struct sx126x_hal_context_cfg_t* config = dev->config;
+    struct sx126x_hal_context_data_t*      data   = dev->data;
+
+    /* Mask NVIC until ClearIrqStatus drops the level-high radio IRQ line. */
+    irq_disable( config->irqn );
+    LL_EXTI_ClearFlag_32_63( LL_EXTI_LINE_44 );
+
+#if defined( CONFIG_LORA_BASICS_MODEM_DRIVERS_EVENT_TRIGGER_OWN_THREAD )
+    k_sem_give( &data->trig_sem );
+#elif defined( CONFIG_LORA_BASICS_MODEM_DRIVERS_EVENT_TRIGGER_GLOBAL_THREAD )
+    k_work_submit( &data->work );
+#elif defined( CONFIG_LORA_BASICS_MODEM_DRIVERS_EVENT_TRIGGER_NO_THREAD )
+    if( data->event_interrupt_cb )
+    {
+        data->event_interrupt_cb( data->sx126x_dev );
+    }
+#endif
+}
+
+void lora_transceiver_board_attach_interrupt( const struct device* dev, event_cb_t cb )
+{
+#ifdef CONFIG_LORA_BASICS_MODEM_DRIVERS_EVENT_TRIGGER
+    struct sx126x_hal_context_data_t* data = dev->data;
+
+    data->event_interrupt_cb = cb;
+#else
+    ARG_UNUSED( dev );
+    ARG_UNUSED( cb );
+    LOG_ERR( "Event trigger not supported!" );
+#endif
+}
+
+void lora_transceiver_board_enable_interrupt( const struct device* dev )
+{
+#ifdef CONFIG_LORA_BASICS_MODEM_DRIVERS_EVENT_TRIGGER
+    const struct sx126x_hal_context_cfg_t* config = dev->config;
+
+    NVIC_ClearPendingIRQ( config->irqn );
+    irq_enable( config->irqn );
+#else
+    ARG_UNUSED( dev );
+    LOG_ERR( "Event trigger not supported!" );
+#endif
+}
+
+void lora_transceiver_board_disable_interrupt( const struct device* dev )
+{
+#ifdef CONFIG_LORA_BASICS_MODEM_DRIVERS_EVENT_TRIGGER
+    const struct sx126x_hal_context_cfg_t* config = dev->config;
+
+    irq_disable( config->irqn );
+#else
+    ARG_UNUSED( dev );
+    LOG_ERR( "Event trigger not supported!" );
+#endif
+}
+
+uint32_t lora_transceiver_get_tcxo_startup_delay_ms( const struct device* dev )
+{
+    const struct sx126x_hal_context_cfg_t* config = dev->config;
+
+    return config->tcxo_cfg.wakeup_time_ms;
+}
+
+#if defined( CONFIG_LORA_BASICS_MODEM_DRIVERS_RAL_RALF )
+void ral_sx126x_bsp_get_tx_cfg( const void* context, const ral_sx126x_bsp_tx_cfg_input_params_t* input_params,
+                                ral_sx126x_bsp_tx_cfg_output_params_t* output_params )
+{
+    const struct device*                   dev    = ( const struct device* ) context;
+    const struct sx126x_hal_context_cfg_t* config = dev->config;
+    int8_t  board_tx_pwr_offset_db                = radio_utilities_get_tx_power_offset( context );
+    int16_t power                                 = input_params->system_output_pwr_in_dbm + board_tx_pwr_offset_db;
+
+    output_params->pa_ramp_time  = config->pa_ramp_time;
+    output_params->pa_cfg.pa_lut = 0x01;
+
+    if( config->pa_hp )
+    {
+        power = CLAMP( power, -9, 22 );
+
+        output_params->pa_cfg.device_sel                 = 0x00;
+        output_params->pa_cfg.hp_max                     = 0x07;
+        output_params->pa_cfg.pa_duty_cycle              = 0x04;
+        output_params->chip_output_pwr_in_dbm_configured = ( int8_t ) power;
+        output_params->chip_output_pwr_in_dbm_expected   = ( int8_t ) power;
+    }
+    else
+    {
+        power = CLAMP( power, -17, 15 );
+
+        output_params->pa_cfg.device_sel = 0x01;
+        output_params->pa_cfg.hp_max     = 0x00;
+        if( power == 15 )
+        {
+            output_params->pa_cfg.pa_duty_cycle              = 0x06;
+            output_params->chip_output_pwr_in_dbm_configured = 14;
+            output_params->chip_output_pwr_in_dbm_expected   = 15;
+        }
+        else
+        {
+            output_params->pa_cfg.pa_duty_cycle              = 0x04;
+            output_params->chip_output_pwr_in_dbm_configured = ( int8_t ) power;
+            output_params->chip_output_pwr_in_dbm_expected   = ( int8_t ) power;
+        }
+    }
+}
+#endif /* CONFIG_LORA_BASICS_MODEM_DRIVERS_RAL_RALF */
+
+static int subghz_board_init( const struct device* dev )
+{
+    const struct sx126x_hal_context_cfg_t* config = dev->config;
+    struct sx126x_hal_context_data_t*      data   = dev->data;
+    int                                    ret;
+
+    /* Match HAL_SUBGHZ_Init(): release RF reset if held, deassert NSS, enable
+     * RFBUSY wakeup signal, and start in deep-sleep state. SUBGHZSPI is
+     * clocked and configured on demand by stm32wl_subghz_hal.c.
+     */
+    LL_RCC_RF_DisableReset( );
+    for( uint32_t i = 0U; ( i < 1000000U ) && ( LL_RCC_IsRFUnderReset( ) != 0U ); i++ )
+    {
+    }
+    LL_PWR_UnselectSUBGHZSPI_NSS( );
+    LL_PWR_SetRadioBusyTrigger( LL_PWR_RADIO_BUSY_TRIGGER_WU_IT );
+    LL_PWR_ClearFlag_RFBUSY( );
+
+    if( config->tx_enable.port )
+    {
+        ret = gpio_pin_configure_dt( &config->tx_enable, GPIO_OUTPUT_INACTIVE );
+        if( ret < 0 )
+        {
+            LOG_ERR( "Could not configure TX enable gpio" );
+            return ret;
+        }
+    }
+    if( config->rx_enable.port )
+    {
+        ret = gpio_pin_configure_dt( &config->rx_enable, GPIO_OUTPUT_INACTIVE );
+        if( ret < 0 )
+        {
+            LOG_ERR( "Could not configure RX enable gpio" );
+            return ret;
+        }
+    }
+    if( config->antenna_enable.port )
+    {
+        ret = gpio_pin_configure_dt( &config->antenna_enable, GPIO_OUTPUT_INACTIVE );
+        if( ret < 0 )
+        {
+            LOG_ERR( "Could not configure antenna enable gpio" );
+            return ret;
+        }
+    }
+
+    /* Across a warm reset the radio may already be in sleep with RFBUSYS high
+     * until NSS asserts; on cold POR it is in STDBY_RC and blocks STOP2.
+     * Starting in RADIO_SLEEP wakes via NSS if needed, then enters warm sleep.
+     */
+    data->radio_status               = RADIO_SLEEP;
+    data->tx_power_offset_db_current = config->tx_power_offset_db;
+    ( void ) sx126x_set_sleep( dev, SX126X_SLEEP_CFG_WARM_START );
+
+#ifdef CONFIG_LORA_BASICS_MODEM_DRIVERS_EVENT_TRIGGER
+    data->sx126x_dev = dev;
+#ifdef CONFIG_LORA_BASICS_MODEM_DRIVERS_EVENT_TRIGGER_GLOBAL_THREAD
+    data->work.handler = subghz_work_cb;
+#elif defined( CONFIG_LORA_BASICS_MODEM_DRIVERS_EVENT_TRIGGER_OWN_THREAD )
+    k_sem_init( &data->trig_sem, 0, K_SEM_MAX_LIMIT );
+    k_thread_create( &data->thread, data->thread_stack,
+                     CONFIG_LORA_BASICS_MODEM_DRIVERS_EVENT_TRIGGER_THREAD_STACK_SIZE,
+                     ( k_thread_entry_t ) subghz_event_thread, data, NULL, NULL,
+                     K_PRIO_COOP( CONFIG_LORA_BASICS_MODEM_DRIVERS_EVENT_TRIGGER_THREAD_PRIORITY ), 0, K_NO_WAIT );
+#endif
+#endif
+
+    LL_EXTI_EnableIT_32_63( LL_EXTI_LINE_44 );
+    return 0;
+}
+
+#if IS_ENABLED( CONFIG_PM_DEVICE )
+static int subghz_pm_action( const struct device* dev, enum pm_device_action action )
+{
+    ARG_UNUSED( dev );
+
+    switch( action )
+    {
+    case PM_DEVICE_ACTION_RESUME:
+        /* SUBGHZSPI clock and CR1/CR2 are restored on the next HAL transfer. */
+        break;
+    case PM_DEVICE_ACTION_SUSPEND:
+        LL_APB3_GRP1_DisableClock( LL_APB3_GRP1_PERIPH_SUBGHZSPI );
+        break;
+    default:
+        return -ENOTSUP;
+    }
+    return 0;
+}
+#endif
+
+#define CONFIGURE_GPIO_IF_IN_DT( node_id, name, dt_prop ) \
+    COND_CODE_1( DT_NODE_HAS_PROP( node_id, dt_prop ), ( .name = GPIO_DT_SPEC_GET( node_id, dt_prop ), ), ( ) )
+
+#define DT_DRV_COMPAT st_stm32wl_subghz_radio
+#define SUBGHZ_NODE   DT_DRV_INST( 0 )
+
+static struct sx126x_hal_context_data_t subghz_data;
+
+static const struct sx126x_hal_context_cfg_t subghz_config = {
+    .spi_max_hz = DT_INST_PROP_OR( 0, spi_max_frequency, 8000000U ),
+    .irqn       = DT_INST_IRQN( 0 ),
+    .pa_hp      = DT_INST_ENUM_HAS_VALUE( 0, power_amplifier_output, rfo_hp ),
+    CONFIGURE_GPIO_IF_IN_DT( SUBGHZ_NODE, tx_enable, tx_enable_gpios )
+    CONFIGURE_GPIO_IF_IN_DT( SUBGHZ_NODE, rx_enable, rx_enable_gpios )
+    CONFIGURE_GPIO_IF_IN_DT( SUBGHZ_NODE, antenna_enable, antenna_enable_gpios )
+    .dio2_as_rf_switch = false,
+    .tcxo_cfg =
+        {
+            /* dio3-tcxo-voltage selects the STM32WL VDDTCXO regulator. */
+            .xosc_cfg = COND_CODE_1( DT_INST_NODE_HAS_PROP( 0, dio3_tcxo_voltage ),
+                                     ( RAL_XOSC_CFG_TCXO_RADIO_CTRL ), ( RAL_XOSC_CFG_XTAL ) ),
+            .voltage        = ( sx126x_tcxo_ctrl_voltages_t ) DT_INST_PROP_OR( 0, dio3_tcxo_voltage, 0 ),
+            .wakeup_time_ms = DT_INST_PROP_OR( 0, tcxo_power_startup_delay_ms, 0 ),
+        },
+    .capa_xta           = 0xFF,
+    .capa_xtb           = 0xFF,
+    .reg_mode           = SX126X_REG_MODE_DCDC,
+    .tx_power_offset_db = DT_INST_PROP_OR( 0, tx_power_offset, 0 ),
+    .rx_boosted         = DT_INST_PROP_OR( 0, rx_boosted, false ),
+    .pa_ramp_time       = DT_INST_PROP_OR( 0, pa_ramp_time, 0x02 ),
+};
+
+static int subghz_init( const struct device* dev )
+{
+    IRQ_CONNECT( DT_INST_IRQN( 0 ), DT_INST_IRQ( 0, priority ), subghz_isr, DEVICE_DT_INST_GET( 0 ), 0 );
+    return subghz_board_init( dev );
+}
+
+PM_DEVICE_DT_INST_DEFINE( 0, subghz_pm_action );
+DEVICE_DT_INST_DEFINE( 0, subghz_init, PM_DEVICE_DT_INST_GET( 0 ), &subghz_data, &subghz_config, POST_KERNEL,
+                       CONFIG_LORA_BASICS_MODEM_DRIVERS_INIT_PRIORITY, NULL );
