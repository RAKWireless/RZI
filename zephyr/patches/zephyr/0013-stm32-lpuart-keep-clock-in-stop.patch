+/* REACK and TEACK follow one kernel clock. Bound the wait so a stopped
+ * clock cannot hang resume.
+ */
+#define UART_STM32_ACK_TIMEOUT_US 1000U
+
 #ifdef CONFIG_PM
 /* Placeholder value when wakeup-line DT property is not defined */
 #define STM32_WAKEUP_LINE_NONE	0xFFFFFFFF
@@ -2612,9 +2617,50 @@ static int uart_stm32_pm_action(const struct device *dev, enum pm_device_action
 				return err;
 			}
 		}
+#if defined(CONFIG_PM) && defined(IS_UART_WAKEUP_FROMSTOP_INSTANCE)
+		else if (config->wakeup_source) {
+			/* With the kernel clock stopped, TXE and TEACK stay clear
+			 * and poll_out() never returns. Clear the latched line
+			 * errors, then wait until TX and RX acknowledge.
+			 */
+#if defined(USART_ISR_REACK) || defined(USART_ISR_TEACK)
+			uint32_t start;
+			const uint32_t ack_timeout_cyc =
+				k_us_to_cyc_ceil32(UART_STM32_ACK_TIMEOUT_US);
+#endif
+
+			LL_USART_ClearFlag_ORE(config->usart);
+			LL_USART_ClearFlag_FE(config->usart);
+			LL_USART_ClearFlag_NE(config->usart);
+#ifdef USART_ISR_REACK
+			start = k_cycle_get_32();
+			while (LL_USART_IsActiveFlag_REACK(config->usart) == 0) {
+				if (k_cycle_get_32() - start > ack_timeout_cyc) {
+					return -ETIMEDOUT;
+				}
+			}
+#endif
+#ifdef USART_ISR_TEACK
+			start = k_cycle_get_32();
+			while (LL_USART_IsActiveFlag_TEACK(config->usart) == 0) {
+				if (k_cycle_get_32() - start > ack_timeout_cyc) {
+					return -ETIMEDOUT;
+				}
+			}
+#endif
+		}
+#endif
 		break;
 	case PM_DEVICE_ACTION_SUSPEND:
 		uart_stm32_suspend_setup(dev);
+#if defined(CONFIG_PM) && defined(IS_UART_WAKEUP_FROMSTOP_INSTANCE)
+		if (config->wakeup_source) {
+			/* Keep the kernel clock. Gating it drops the waking
+			 * character and leaves TXE and TEACK clear.
+			 */
+			break;
+		}
+#endif
 		/* Stop device clock. Note: fixed clocks are not handled yet. */
 		err = clock_control_off(config->clock, (clock_control_subsys_t)&config->pclken[0]);
 		if (err < 0) {
