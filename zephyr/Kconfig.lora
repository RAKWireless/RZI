config RZI_LORA
	bool "RZI raw LoRa and FSK service"
	help
	  Enable the backend-independent RZI raw LoRa and FSK service used by
	  P2P AT commands and radio certification tests.

if RZI_LORA

choice RZI_LORA_BACKEND
	prompt "Raw LoRa backend"
	default RZI_LORA_BACKEND_TEST if ZTEST
	default RZI_LORA_BACKEND_USP if RZI_LORAWAN_BACKEND_USP
	default RZI_LORA_BACKEND_ZEPHYR if LORA

config RZI_LORA_BACKEND_TEST
	bool "In-process test backend"
	depends on ZTEST
	help
	  Software loopback used by host tests. Do not use this option in
	  production firmware.

config RZI_LORA_BACKEND_USP
	bool "Semtech USP radio access controller"
	depends on RZI_LORAWAN_BACKEND_USP
	select RZI_USP
	help
	  Run P2P send and receive as USP radio access controller (RAC)
	  transactions below LoRaWAN priority, so P2P and LoRaWAN share the
	  radio. Radio certification tests (CW, PER, RSSI) use the LoRa Basics
	  Modem test mode, which suspends LoRaWAN until rzi_lora_stop().

config RZI_LORA_BACKEND_ZEPHYR
	bool "Zephyr LoRa driver"
	depends on LORA
	help
	  Use Zephyr's public <zephyr/drivers/lora.h> driver. This cannot be
	  combined with CONFIG_RZI_LORAWAN_BACKEND_USP.

endchoice

config RZI_LORA_USP_RX_IRQ_WAKE
	bool "Allow system STOP while P2P receive is listening (radio IRQ wake)"
	depends on RZI_LORA_BACKEND_USP && PM
	default y if DT_HAS_ST_STM32WL_SUBGHZ_RADIO_ENABLED
	help
	  Do not hold a PM reference merely because a P2P receive window is
	  open. The radio remains in RX and its completion or timeout IRQ
	  wakes the MCU from STOP, the USP thread queues the packet, and the
	  wake hook unblocks the AT thread. TX, pending cancellation, and
	  undelivered completions still hold a PM reference until drained.

endif # RZI_LORA
